# Copy this file to .env and fill in your real league ID and ESPN cookies.
# League ID is the leagueId parameter in your ESPN Fantasy league URL.
ESPN_LEAGUE_ID=
ESPN_YEAR=2026
# From browser developer tools, copy the espn_s2 and SWID cookie values
# while signed in to ESPN. Preserve braces around SWID if present.
ESPN_S2=
ESPN_SWID=
# Optional: use only if SWID does not uniquely identify your fantasy team.
ESPN_TEAM_ID=
# Optional server-only path for the persistent SQLite watchlist.
WATCHLIST_DB_PATH=.data/watchlist.sqlite3
